# ── Backend ───────────────────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/watch-party
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_RETRIES=5
MONGODB_SERVER_SELECTION_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
JWT_SECRET=replace_with_secure_jwt_secret
JWT_EXPIRES_IN=24h
# CORS origin — set to wherever the frontend SPA is served from
CLIENT_URL=http://localhost:8080
NODE_ENV=development
COOKIE_SECRET=replace_with_secure_cookie_secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Redis — used for shared room state and Socket.IO cross-instance pub/sub
# Docker Compose sets this to redis://redis:6379 automatically via the compose file
REDIS_URL=redis://localhost:6379

# After deploying backend containers, run the following to ensure DB indexes are created:
# cd backend && npm run create-indexes

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
# In Docker Compose, all traffic goes through the Nginx load balancer on :80.
# For bare-metal local dev (no Docker), point directly at the backend on :5000.
VITE_API_BASE_URL=http://localhost/api
VITE_SOCKET_URL=http://localhost
VITE_YOUTUBE_API_KEY=replace_with_youtube_api_key_if_needed

# ── Port reference (Docker Compose) ──────────────────────────────────────────
# :80   → Nginx load balancer (API + Socket.IO entry point)
# :8080 → Frontend static SPA
# Redis, Mongo — internal only, not exposed to the host
